{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "status",
    "generatedAt",
    "source",
    "weekly",
    "tokens",
    "trend"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "status": {
      "enum": [
        "unavailable",
        "partial",
        "ok"
      ]
    },
    "generatedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "observedAt",
        "stale",
        "upstreamProvenance",
        "displayTimeZone",
        "usageDayTimeZone"
      ],
      "properties": {
        "kind": {
          "const": "existing-memory-cache"
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "upstreamProvenance": {
          "const": "not-independently-verified"
        },
        "displayTimeZone": {
          "const": "Asia/Shanghai"
        },
        "usageDayTimeZone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "weekly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remainingPercent",
        "resetsAt",
        "windowMinutes",
        "observedAt",
        "stale"
      ],
      "properties": {
        "remainingPercent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "resetsAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "windowMinutes": {
          "const": 10080
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "stale",
        "today",
        "latestDaily",
        "lifetime",
        "last30Days"
      ],
      "properties": {
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "today": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "value",
            "reason"
          ],
          "properties": {
            "date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "latestDaily": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "date",
            "value"
          ],
          "properties": {
            "date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "lifetime": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            }
          }
        },
        "last30Days": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "complete",
            "reason"
          ],
          "properties": {
            "value": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "complete": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          }
        }
      }
    },
    "trend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "stale",
        "periodDays",
        "usageDayTimeZone",
        "knownDays",
        "points"
      ],
      "properties": {
        "observedAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "periodDays": {
          "const": 14
        },
        "usageDayTimeZone": {
          "type": [
            "string",
            "null"
          ]
        },
        "knownDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 14
        },
        "points": {
          "type": "array",
          "minItems": 14,
          "maxItems": 14,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "tokens"
            ],
            "properties": {
              "date": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "tokens": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        }
      }
    }
  }
}